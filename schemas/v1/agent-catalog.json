{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "agents", "catalog_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "version", "status", "roles", "task_kinds", "skill_refs", "required_capabilities",
          "review_agent_id"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"const": "active"},
          "roles": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["owner", "maintainer", "engineer", "analyst"]}
          },
          "task_kinds": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"}
          },
          "skill_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_capabilities": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 3, "maxLength": 128}
          },
          "review_agent_id": {"type": ["string", "null"]}
        }
      }
    },
    "catalog_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
