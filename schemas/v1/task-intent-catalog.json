{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promptforge://schemas/v1/task-intent-catalog.json",
  "title": "Versioned deterministic task intent catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intake_version", "rules", "intent_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "intake_version": {"const": "1.0.0"},
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["task_kind", "phrases"],
        "properties": {
          "task_kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"},
          "phrases": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 2, "maxLength": 128}
          }
        }
      }
    },
    "intent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
