{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local audit receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "event_id", "previous_hash", "event_hash", "occurred_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "previous_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "occurred_at": {"type": "integer", "minimum": 0}
  }
}
