{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable token usage receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "store_version", "sequence", "trace_id", "receipt_digest", "record_digest", "recorded_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "store_version": {"const": "1.0.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "trace_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recorded_at": {"type": "integer", "minimum": 0}
  }
}
