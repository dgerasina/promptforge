{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local integration credential update receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "service", "auth_mode", "credential_exposed", "network_used"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "rotated"},
    "service": {"const": "jira"},
    "auth_mode": {"const": "bearer-token"},
    "credential_exposed": {"const": false},
    "network_used": {"const": false}
  }
}
