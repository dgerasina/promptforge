{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptforge.local/schemas/v1/neutrality-report.json",
  "title": "NeutralityReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "policy_version", "files_scanned", "violations", "violations_digest", "network_used"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["passed", "blocked"]},
    "policy_version": {"const": "neutrality-v1"},
    "files_scanned": {"type": "integer", "minimum": 1},
    "violations": {"type": "integer", "minimum": 0},
    "violations_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "network_used": {"const": false}
  }
}
