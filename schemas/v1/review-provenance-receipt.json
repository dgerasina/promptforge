{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review provenance receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sequence", "review_id", "request_digest", "result_digest", "receipt_digest",
    "record_digest", "recorded_at", "review_version"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "review_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "result_digest": {"$ref": "#/$defs/digest"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "record_digest": {"$ref": "#/$defs/digest"},
    "recorded_at": {"type": "integer", "minimum": 0},
    "review_version": {"const": "2.0"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
