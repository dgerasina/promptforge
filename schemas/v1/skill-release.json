{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "version", "owner", "description", "status", "roles", "risk",
    "audiences", "entrypoint", "inputs_schema", "permissions", "compatibility", "evals", "reviewer_set",
    "content_digest", "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review", "approved", "deprecated", "quarantined", "revoked"]},
    "roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["owner", "maintainer", "engineer", "analyst"]}
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "entrypoint": {"const": "SKILL.md"},
    "inputs_schema": {"type": "string", "pattern": "^schemas/[a-z0-9._-]+\\.json$"},
    "permissions": {
      "type": "object", "additionalProperties": false, "required": ["required", "forbidden"],
      "properties": {
        "required": {"$ref": "#/$defs/permissions"},
        "forbidden": {"$ref": "#/$defs/permissions"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["clients"],
      "properties": {"clients": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}
    },
    "evals": {"type": "string", "pattern": "^evals/[a-z0-9._-]+\\.json$"},
    "reviewer_set": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^(|minisign:.+|repository:v1:[a-f0-9]{64})$"}
  },
  "$defs": {
    "permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"}
    }
  }
}
