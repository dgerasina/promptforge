{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation impact report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "targets", "current", "drift", "blocked", "documents", "network_used"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "ok"},
    "targets": {"type": "integer", "minimum": 1, "maximum": 100},
    "current": {"type": "integer", "minimum": 0},
    "drift": {"type": "integer", "minimum": 0},
    "blocked": {"type": "integer", "minimum": 0},
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version", "status", "document_id", "document_path", "source_digest", "document_digest",
          "patch_digest", "changed_lines", "reason_codes"
        ],
        "properties": {
          "schema_version": {"const": "1.0"},
          "status": {"enum": ["current", "drift", "blocked"]},
          "document_id": {"type": "string", "minLength": 1},
          "document_path": {"type": "string", "minLength": 1},
          "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "document_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "patch_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "changed_lines": {"type": "integer", "minimum": 0},
          "reason_codes": {
            "type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true
          }
        }
      }
    },
    "network_used": {"const": false}
  }
}
